rules_version = '2';

// Deny everything. The ARM service reaches Firestore as an administrative
// caller whose credentials bypass these rules; a browser has no business in
// this database at all, and a test that passed because the rules were open
// would prove nothing about the service.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
