rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          request.auth.token.email.size() > 3;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function hasSuperuserClaim() {
      return request.auth.token.arm_console_superuser == true ||
          request.auth.token.armConsoleSuperuser == true ||
          request.auth.token.superuser == true;
    }

    // Temporary bootstrap owner until custom-claim management exists.
    function isBootstrapSuperuser() {
      return hasVerifiedEmail() &&
          authEmail() == 'obsidian.infinitum@gmail.com';
    }

    function isSuperuser() {
      return hasVerifiedEmail() &&
          (hasSuperuserClaim() || isBootstrapSuperuser());
    }

    function ownAccessPath() {
      return /databases/$(database)/documents/console_access/$(authEmail());
    }

    function ownAccessExists() {
      return hasVerifiedEmail() && exists(ownAccessPath());
    }

    function ownDeveloperProjectIds() {
      return ownAccessExists() &&
          get(ownAccessPath()).data.developerProjectIds is list
          ? get(ownAccessPath()).data.developerProjectIds
          : [];
    }

    function ownViewerProjectIds() {
      return ownAccessExists() &&
          get(ownAccessPath()).data.viewerProjectIds is list
          ? get(ownAccessPath()).data.viewerProjectIds
          : ownLegacyProjectIds();
    }

    function ownLegacyProjectIds() {
      return ownAccessExists() &&
          get(ownAccessPath()).data.projectIds is list
          ? get(ownAccessPath()).data.projectIds
          : ownAccessExists() && get(ownAccessPath()).data.projects is list
          ? get(ownAccessPath()).data.projects
          : [];
    }

    function hasScopedProjectAccess(projectId) {
      return ownDeveloperProjectIds().hasAny([projectId]) ||
          ownViewerProjectIds().hasAny([projectId]);
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    function validRequiredString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validOptionalString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function validTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function validProjectEnvironment(value) {
      return value in ['production', 'staging', 'development', 'sandbox'];
    }

    function validConnectionStatus(value) {
      return value in ['unknown', 'healthy', 'warning', 'failed'];
    }

    function validFirebaseMap(firebase) {
      return firebase is map &&
          hasOnlyKeys(firebase, [
            'apiKey',
            'appId',
            'messagingSenderId',
            'projectId',
            'authDomain',
            'databaseUrl',
            'storageBucket',
            'measurementId',
            'androidClientId',
            'iosClientId',
            'iosBundleId',
          ]) &&
          validRequiredString(firebase.apiKey, 1, 256) &&
          validRequiredString(firebase.appId, 1, 256) &&
          validRequiredString(firebase.messagingSenderId, 1, 64) &&
          validRequiredString(firebase.projectId, 1, 128) &&
          validOptionalString(firebase.authDomain, 256) &&
          validOptionalString(firebase.databaseUrl, 512) &&
          validOptionalString(firebase.storageBucket, 256) &&
          validOptionalString(firebase.measurementId, 128) &&
          validOptionalString(firebase.androidClientId, 256) &&
          validOptionalString(firebase.iosClientId, 256) &&
          validOptionalString(firebase.iosBundleId, 256);
    }

    function validConnectionMap(connection) {
      return connection is map &&
          hasOnlyKeys(connection, ['status', 'summary', 'checkedAt']) &&
          validConnectionStatus(connection.status) &&
          validRequiredString(connection.summary, 1, 240) &&
          validTimestampOrNull(connection.checkedAt);
    }

    function validProjectDocument(projectId) {
      return hasOnlyKeys(request.resource.data, [
            'name',
            'environment',
            'description',
            'firebase',
            'developerEmails',
            'viewerEmails',
            'isReadOnlyConsole',
            'connection',
            'createdAt',
            'updatedAt',
            'createdBy',
            'updatedBy',
          ]) &&
          projectId.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$') &&
          validRequiredString(request.resource.data.name, 1, 120) &&
          validProjectEnvironment(request.resource.data.environment) &&
          validOptionalString(request.resource.data.description, 500) &&
          validFirebaseMap(request.resource.data.firebase) &&
          request.resource.data.developerEmails is list &&
          request.resource.data.developerEmails.size() <= 20 &&
          request.resource.data.viewerEmails is list &&
          request.resource.data.viewerEmails.size() <= 20 &&
          request.resource.data.isReadOnlyConsole is bool &&
          validConnectionMap(request.resource.data.connection) &&
          validTimestampOrNull(request.resource.data.createdAt) &&
          validTimestampOrNull(request.resource.data.updatedAt) &&
          validOptionalString(request.resource.data.createdBy, 200) &&
          validOptionalString(request.resource.data.updatedBy, 200);
    }

    function validAccessDocument(email) {
      return hasOnlyKeys(request.resource.data, [
            'email',
            'developerProjectIds',
            'viewerProjectIds',
            'projectIds',
            'updatedAt',
            'updatedBy',
          ]) &&
          request.resource.data.email == email &&
          validRequiredString(request.resource.data.email, 3, 200) &&
          request.resource.data.developerProjectIds is list &&
          request.resource.data.developerProjectIds.size() <= 50 &&
          request.resource.data.viewerProjectIds is list &&
          request.resource.data.viewerProjectIds.size() <= 50 &&
          request.resource.data.projectIds is list &&
          request.resource.data.projectIds.size() <= 50 &&
          validTimestampOrNull(request.resource.data.updatedAt) &&
          validOptionalString(request.resource.data.updatedBy, 200);
    }

    match /console_access/{email} {
      allow read: if isSuperuser() || (hasVerifiedEmail() && authEmail() == email);
      allow create, update: if isSuperuser() && validAccessDocument(email);
      allow delete: if false;
    }

    match /console_projects/{projectId} {
      allow read: if isSuperuser() ||
          (hasVerifiedEmail() && hasScopedProjectAccess(projectId));
      allow create, update: if isSuperuser() && validProjectDocument(projectId);
      allow delete: if false;
    }
  }
}
